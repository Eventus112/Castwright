# Copy this file to .env before running Docker Compose.

# Linux + NVIDIA: merge the GPU override automatically, so the normal command
# remains `docker compose up --build -d`. Remove this line for the CPU profile.
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml

# Persistent host directory. Replacing the image does not remove this data.
CASTWRIGHT_DATA_DIR=./data

# Existing Castwright workspace (books, workspace voices, backups). Point this
# at the native installation's WORKSPACE_DIR to migrate without copying data.
CASTWRIGHT_WORKSPACE_DIR=./data/workspace

# Existing native user settings directory (normally ~/.castwright).
CASTWRIGHT_SETTINGS_DIR=./data/settings

# Existing Hugging Face cache. Qwen/other model weights are mounted rather than
# copied into or re-downloaded by the image. Compose expands HOME from the host.
CASTWRIGHT_HF_CACHE_DIR=${HOME}/.cache/huggingface

# Set both to 1 when every required model is already cached and Docker must not
# make any model download. Leave at 0 if in-app model installation is desired.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# The published web port stays on host loopback unless you explicitly change it.
CASTWRIGHT_BIND_ADDRESS=127.0.0.1
CASTWRIGHT_PORT=8080

# Runtime identity used for new files in CASTWRIGHT_DATA_DIR.
PUID=1000
PGID=1000

# Optional replacement image name/tag.
CASTWRIGHT_IMAGE=castwright:local

# Optional ops override. Leave ANALYZER_PROVIDER blank to configure Ollama,
# OpenAI-compatible, or Gemini from Model Manager in the web UI.
ANALYZER_PROVIDER=
OPENAI_BASE_URL=http://host.docker.internal:5001/v1
OPENAI_MODEL=castwright
# Optional for an unauthenticated local endpoint. Never put this in Dockerfile.
OPENAI_API_KEY=
